.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Secrets: .env is real, .env.example is the template that is committed.
.env
*.key
*.pem
secrets/*
# ...except the templates that say how to fill them in (secrets/README.md).
!secrets/README.md
!secrets/*.example

# e2e artifacts are per-run output, never history.
.e2e/artifacts/

# Vendored upstream data-plane binaries (scripts/fetch-upstream-checkers.sh).
# A third party's compiled binary does not belong in our history; the script that
# fetches it, pinned and checksummed, does.
.tools/

# e2e secrets: generated (throwaway) and live (real, spend-capped) — both
# real, never .example. See docs/e2e/README.md §8 and CLAUDE.md.
.env.e2e.generated
.env.e2e.live.secrets

.DS_Store

# Local database dumps (scripts/backup.sh). Encrypted, but still every node
# credential and every user token in one file — never in git.
backups/

# aikit acceptance evidence: screenshots and tree dumps, per-run output. They
# swell the repository and leave nothing readable in the history. The tracker
# directory (docs/tracker/) holds the verdict TEXT and IS committed.
.acceptance/

# Docker CLI config. The e2e helpers run `docker` with no HOME, so it lands here
# rather than in the operator's home directory. Nothing in it is ours.
.docker/
