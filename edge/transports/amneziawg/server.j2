{#
  An AmneziaWG interface configuration, in wg-quick's INI format.

  WHAT: this end of one hop, plus a [Peer] block per authorised peer.
  WHY:  note what is NOT here: no logging directive of any kind. WireGuard's kernel
        module can be made to log handshakes, which records which endpoint connected
        and when — the one record the charter says must not exist. The absence is the
        feature.
  HOW:  rendered by render.py. This is NOT JSON, so `tojson` would be wrong here;
        values are constrained by Params instead — every field is an integer, a
        validated base64 key, or a parsed IP interface, so none of them can contain a
        newline and break out of its line. That is why Params is strict rather than
        merely helpful.
#}
# Generated by hashi. Do not edit on the node — overwritten on every apply.
[Interface]
PrivateKey = {{ params.private_key }}
Address = {{ params.tunnel_address }}
ListenPort = {{ params.port }}
MTU = {{ params.mtu }}
{% if table %}

# This interface's routes are ours to install, so the tool installs none — M3. The peer
# below is allowed every address, because AllowedIPs is WireGuard's crypto-routing table
# as well as its authorisation list and a narrower one drops a friend's traffic on the
# way out. What made that dangerous was never AllowedIPs but the DEFAULT ROUTE wg-quick
# would derive from it: with `Table = off` nothing is installed in the main table, so the
# node's own traffic — the SSH session the control plane manages it over above all —
# keeps leaving the way it always did. Only what the PostUp rule sources from this
# tunnel's own address goes through the tunnel.
Table = {{ table }}
{% endif %}
{% if hooks %}

# This tunnel's egress policy, tied to the interface's own life — M14 and M3. It is one
# of two things and the renderer decides which: the forwarding and NAT that let a
# decrypted packet leave this node (without them the handshake completes, the interface
# is up, and nothing moves), or the source-routed way OUT through this tunnel that an
# entry node's friend traffic takes. Written here rather than into host state because a
# node holds nothing that cannot be regenerated, and because a rule the interface did not
# add is a rule its removal will not take away.
#
# No interface name appears: `%i` is wg-quick's own substitution for the interface it is
# bringing up, and the masquerade matches "left by anything that is NOT the tunnel"
# rather than naming an egress device that is not called the same thing on every host.
PostUp = {{ hooks.up }}
PostDown = {{ hooks.down }}
{% endif %}

# AmneziaWG obfuscation. Per-node values: shared ones would themselves be the
# fingerprint that identifies the fleet.
Jc = {{ params.junk_packet_count }}
Jmin = {{ params.junk_packet_min_size }}
Jmax = {{ params.junk_packet_max_size }}
H1 = {{ params.init_packet_magic_header }}
H2 = {{ params.response_packet_magic_header }}
H3 = {{ params.underload_packet_magic_header }}
H4 = {{ params.transport_packet_magic_header }}
{% for peer in peers %}

[Peer]
# {{ peer.label }}
PublicKey = {{ peer.public_key }}
PresharedKey = {{ params.preshared_key }}
{% if peer.endpoint %}
# Where this peer is dialled. Only ONE end of a hop has this: the other sits behind a
# carrier NAT and can never be dialled, so it waits and is found by the handshake.
Endpoint = {{ peer.endpoint }}
{% endif %}
# The far end's own address, unless this tunnel is the node's way out — in which case it
# is every address, and the `Table = off` note above says why that is safe there and only
# there. A wide entry on any other tunnel would let that peer source traffic as any
# address in the range.
AllowedIPs = {{ peer.allowed_ips }}
# Keeps the UDP path open through NAT and stateful firewalls on the way out of
# Russia. 25s is below the shortest common UDP idle timeout.
PersistentKeepalive = 25
{% endfor %}
