.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Secrets: .env is real, .env.example is the template that is committed.
.env
*.key
*.pem
secrets/

# e2e artifacts are per-run output, never history.
.e2e/artifacts/

# Vendored upstream data-plane binaries (scripts/fetch-upstream-checkers.sh).
# A third party's compiled binary does not belong in our history; the script that
# fetches it, pinned and checksummed, does.
.tools/

# e2e secrets: generated (throwaway) and live (real, spend-capped) — both
# real, never .example. See docs/e2e/README.md §8 and CLAUDE.md.
.env.e2e.generated
.env.e2e.live.secrets

.DS_Store
