# hashi — environment template. Copy to .env and fill in.
# Every value here is FAKE or blank. Never commit a real one; never print .env.

# --- control plane ----------------------------------------------------------
# Encrypts node keys and provider credentials at rest. The app refuses to start
# without it. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
HASHI_SECRET_KEY=replace-me-with-48-random-bytes

# Public hostname of the delivery endpoint. Must be reachable from inside Russia,
# or users cannot refresh configs exactly when a node has just been blocked.
#
# A NAME with a real DNS record, never a bare address. A public CA cannot issue for an
# IP, so Caddy falls back to its own CA and every stock client refuses the certificate —
# the subscription then fails for every user while nothing on the host looks wrong.
HASHI_PUBLIC_HOST=hashi.example.com

# --- reaching the panel (M7) -------------------------------------------------
# The console is NOT on the public hostname above. Caddy serves two sites: the
# public one answers `/sub/*` and 404s everything else, and a private one answers
# `/panel/*`, `/api/*` and `/static/*` on the port below — published only on the
# management tunnel's address and on loopback. See docs/deploy/runbook.md,
# "Reaching the panel".
#
# What the owner's device asks for over the tunnel. **An address is the expected
# value**, because that is what a WireGuard tunnel hands you — and because a phone
# cannot be given a hosts entry, so a name is not available on the device most likely
# to be reached for in an emergency.
#
# Caddy issues this certificate from its own CA, so the value never reaches a public
# CA's logs. It is also the Caddyfile's `default_sni`: a TLS client sends no SNI when
# the host is an IP literal, so this is the certificate served to a client that named
# no host at all — which, over this tunnel, is every client.
#
# A NAME works too and costs a hosts entry on every device that must reach the console.
# It buys one thing: because default_sni is global, a no-SNI connection to the PUBLIC
# port is answered with this certificate as well, so whatever is written here is
# disclosed to anyone who asks that way. An address is private and unroutable, which is
# why it is still the default.
HASHI_PRIVATE_HOST=10.0.0.1

# Where Caddy listens for that site. Inside this project's block (54100–54299) and
# not a service default. Changing it changes both the container's listener and the
# published mapping — they are the same variable on purpose, so they cannot drift.
HASHI_PRIVATE_PORT=54143

# Which address on THIS host the private port is published on — the management
# tunnel's own address, and nothing else. Read only by deploy/docker-compose.public.yml
# (`make up-panel`); `make up` and `make up-dev` never publish it at all.
#
# Never 127.0.0.1: the fallback mapping already claims loopback for this port, and
# docker refuses the second bind with "port is already allocated".
HASHI_PRIVATE_BIND_ADDR=10.0.0.1

# --- the management tunnel (optional; scripts/management-tunnel.sh) ----------
# Read by the tunnel generator that `make panel-bootstrap` runs. Absent means no
# tunnel is generated and the panel is reachable only over the SSH fallback — a
# real mode, and the bootstrap says so rather than pretending otherwise.
#
# Everything here is per-deployment. Nothing is defaulted: a shared address range
# collides with a hop, and a shared port is a port the fleet cannot move away from.
#
# This host's end of the tunnel, with a prefix.
HASHI_MGMT_ADDRESS=10.0.0.1/24
# The UDP port the tunnel listens on. Open it in the host firewall.
HASHI_MGMT_PORT=51821
# Where the owner's devices dial this host. An address or a name, no port.
HASHI_MGMT_ENDPOINT=hashi.example.com
# Explicit and required, exactly as the transport requires it — never defaulted.
HASHI_MGMT_MTU=1420
# The owner's devices, `name=address`, comma separated. At least two, because an
# owner has a laptop and a phone: this tunnel takes N peers by construction and is
# deliberately NOT a node_transports row, which carries one peer address and would
# therefore serve one device.
HASHI_MGMT_PEERS=laptop=10.0.0.2/32,phone=10.0.0.3/32

# --- the operator ------------------------------------------------------------
# There is exactly one operator (charter: "one operator, one fleet"), so these come
# from the environment rather than from a users table — a table would imply the
# public signup the charter names as a non-goal.
#
# NEVER put the password itself here. Generate the hash on your own machine:
#   python -m control.cli hash-password
# It prompts, so the plaintext stays out of your shell history too.
#
# Paste the line it prints EXACTLY as printed, doubled $$ and all, and do not double
# them again. docker compose interpolates the values it reads from this file and turns
# each $$ back into one $; a lone $ there would start a variable reference and the rest
# of that field would arrive empty — which is a control plane its own operator cannot
# log into, with a correct-looking hash sitting right here. The control plane now
# refuses to start on a hash that is not one, so the mistake is loud either way.
HASHI_OPERATOR_USERNAME=owner
HASHI_OPERATOR_PASSWORD_HASH=run-python--m-control.cli-hash-password-and-paste-the-output

# --- database ---------------------------------------------------------------
POSTGRES_USER=hashi
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=hashi

# HASHI_DATABASE_URL is NOT set here on purpose: deploy/docker-compose.yml composes
# it from the three values above, so the app and the database cannot be pointed at
# different places. Set it by hand only when running the app outside compose, e.g.
# against a loopback-published dev database:
#   HASHI_DATABASE_URL=postgresql+asyncpg://hashi:replace-me@127.0.0.1:54132/hashi

# --- caddy ------------------------------------------------------------------
# Email used for ACME registration.
CADDY_ACME_EMAIL=owner@example.com

# --- offsite backup (M28) ----------------------------------------------------
# Everything the control plane generates, uploaded once a day to an object store
# that is not this host. The store is addressed by the S3 protocol, NOT by a
# provider name: CLAUDE.md forbids hardcoding a provider exactly as it forbids
# hardcoding a node, and for the same reason — a provider you cannot rotate away
# from is a provider you are stuck with on the day you need to leave it.
#
# Absent or HASHI_BACKUP_ENABLED=0 means no offsite backup and nothing scheduled.
# That is a real mode and the stack says so rather than pretending it is covered.
HASHI_BACKUP_ENABLED=0

# The endpoint, region and bucket of the object store. All three are per-
# deployment and none is defaulted, because a default here is a silent upload to
# somebody else's idea of the right country.
#
# The endpoint is the store's OWN address, with a scheme; the bucket goes in the
# PATH — https://<endpoint>/<bucket>/<prefix><file>. Do not fold the bucket into
# the hostname: that form asks the store to answer for every bucket name as a
# subdomain, which is one provider's DNS convention rather than the protocol, and
# the point of this block is that the store is replaceable. Use https — over http
# the key id below and the name of your bucket travel in the clear, and the upload
# refuses unless the endpoint resolves to a private network.
HASHI_BACKUP_S3_ENDPOINT=https://storage.example.net
HASHI_BACKUP_S3_REGION=example-region-1
HASHI_BACKUP_S3_BUCKET=example-bucket-name
# Optional key prefix inside the bucket. Blank puts objects at the root.
HASHI_BACKUP_S3_PREFIX=control/

# The credential this host uploads with. It must be WRITE-ONLY — PutObject and
# nothing else: no DeleteObject, no ListBucket, no GetObject.
#
# This is not belt-and-braces. An attacker who holds this box holds this key, and
# a key that can delete turns a seizure into a total loss of the backup history
# as well as the machine. But a key that can only write can still overwrite: it
# chooses the object's name, so it can write over a name that is already there.
# What makes write-only stick is BUCKET VERSIONING, which is required, plus
# object lock where the store has it and a lifecycle rule whose expiry you
# chose. That is settled in docs/deploy/runbook.md, "The retention this host's
# own key cannot reach", which also says how to check it is on — you cannot
# check it with this key.
HASHI_BACKUP_S3_ACCESS_KEY_ID=
HASHI_BACKUP_S3_SECRET_ACCESS_KEY=

# What a failed upload leaves you holding: the artifact, here, intact — and
# `make backup` exiting 3 rather than 0, because a backup that never left the
# machine is not an offsite backup and must not be reported as one. Send the same
# file when the store is reachable again with `make backup-upload FROM=<path>`;
# nothing is dumped a second time.

# The age public key the dump is encrypted TO, before it leaves this host.
#
# Decided by the owner 2026-09-22: the whole dump is encrypted, not just the
# columns the application encrypts. Without this, a reader of the bucket who
# never obtains HASHI_SECRET_KEY still gets every node's real address — including
# the leaf addresses a user is never shown — plus how many users there are
# and when each one arrived.
#
# A KEYPAIR, deliberately, not a passphrase: this host holds only the public
# half, so it can encrypt a backup and cannot read one back. The private identity
# never touches this machine. It is what you carry, beside HASHI_SECRET_KEY, and
# the two of them are what a restore costs.
#
# Leave blank for now — the keypair is generated during M28 and you will be given
# the private half to keep; the public half is what goes here.
HASHI_BACKUP_AGE_RECIPIENT=

# When the daily run happens, and in which zone. The zone is explicit because a
# host's clock is UTC and its owner is not, and "04:00" that silently means
# something else is only ever discovered during a restore.
HASHI_BACKUP_AT=04:00
HASHI_BACKUP_TZ=Etc/UTC

# NOT SET HERE, on purpose: the credentials a RESTORE needs.
#
# Restoring reads from the bucket, so it needs a GetObject credential — which is
# exactly what this host must not hold, or the write-only key above bought
# nothing. Nothing in this repository reads the two S3 names below yet: until the
# one-command restore exists you fetch the object yourself, with your own client,
# from a machine that is not this one. What the restore does read from its own
# environment, today, is the age identity. All three are carried, never stored:
#
#   HASHI_RESTORE_S3_ACCESS_KEY_ID, HASHI_RESTORE_S3_SECRET_ACCESS_KEY
#   HASHI_RESTORE_AGE_IDENTITY  (path to the private half of the key above)
#
# Never write them into this file on the control plane's own host.

# --- the agent fleet ---------------------------------------------------------
# Moved out: GH_TOKEN, GIT_USER_NAME, GIT_USER_EMAIL, REPO_URL, MAX_CONCURRENT
# and REASONING_EFFORT now live in deploy/warden/.env(.example), the fleet's
# own env file — a fleet building this app should not need this file's
# secrets, and this app should not need the fleet's. See deploy/warden/README.md.

# --- published ports --------------------------------------------------------
# This project's block is 54100–54299, bound to 127.0.0.1 only. The offsets are
# readable on purpose: +00 app HTTP, +32 Postgres (5432), +90 gRPC. The e2e
# stack takes the next hundred so both can run at the same time.
#
# Never publish a service's default (5432, 6379, 8000, 3000…): the host already
# runs something — Kaizen's own dev overlay publishes 127.0.0.1:5432. Inside the
# compose network services keep their standard ports, which never collide.
HOST_PORT_BASE=54100
DEV_API_PORT=54100
DEV_DB_PORT=54132
E2E_API_PORT=54200
E2E_DB_PORT=54232
