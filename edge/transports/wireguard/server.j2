{#
  A plain WireGuard interface, in wg-quick's INI format.

  WHAT: this node's interface, plus a [Peer] block per authorised user.
  WHY:  note what is NOT here, and it is the same absence as in the AmneziaWG template:
        no logging directive of any kind. WireGuard's kernel module can be made to log
        handshakes, which records which endpoint connected and when — the one record the
        charter says must not exist. The absence is the feature.

        Note also what is not here and is not an omission: no obfuscation. Plain
        WireGuard has none. That is why this transport declares
        ``blocked_by_inspection`` and is refused on the border-crossing hop.
  HOW:  rendered by render.py. Not JSON, so `tojson` would be wrong; every value is an
        integer, a validated base64 key or a parsed IP interface, so none can contain a
        newline and break out of its line. Params is strict for that reason.
#}
# Generated by hashi. Do not edit on the node — overwritten on every apply.
[Interface]
PrivateKey = {{ params.private_key }}
Address = {{ params.tunnel_address }}
ListenPort = {{ params.port }}
MTU = {{ params.mtu }}
{% if table %}

# This interface's routes are ours to install, so the tool installs none — M3. The peer
# below is allowed every address, because AllowedIPs is WireGuard's crypto-routing table
# as well as its authorisation list and a narrower one drops a user's traffic on the
# way out. What made that dangerous was never AllowedIPs but the DEFAULT ROUTE wg-quick
# would derive from it: with `Table = off` nothing is installed in the main table, so the
# node's own traffic — the SSH session the control plane manages it over above all —
# keeps leaving the way it always did. Only what the PostUp rule sources from this
# tunnel's own address goes through the tunnel.
Table = {{ table }}
{% endif %}
{% if hooks %}

# This tunnel's egress policy, tied to the interface's own life — M14 and M3. It is one
# of two things and the renderer decides which: the forwarding and NAT that let a
# decrypted packet leave this node (without them the handshake completes, the interface
# is up, and nothing moves), or the source-routed way OUT through this tunnel that an
# entry node's user traffic takes. Written here rather than into host state because a
# node holds nothing that cannot be regenerated, and because a rule the interface did not
# add is a rule its removal will not take away.
#
# No interface name appears: `%i` is wg-quick's own substitution for the interface it is
# bringing up, and the masquerade matches "left by anything that is NOT the tunnel"
# rather than naming an egress device that is not called the same thing on every host.
PostUp = {{ hooks.up }}
PostDown = {{ hooks.down }}
{% endif %}
{% for peer in peers %}

[Peer]
# {{ peer.label }}
PublicKey = {{ peer.public_key }}
# This peer's OWN pre-shared key. Per PAIR, which is what WireGuard's design makes
# it: one value across every peer meant one leaked config exposed the symmetric
# layer protecting everyone else here, and revoking that peer rotated nothing.
PresharedKey = {{ peer.preshared_key }}
# Exactly this peer's own address, never the whole prefix and never a default route:
# AllowedIPs is WireGuard's authorisation list as well as its routing table, so a wide
# entry here would let one user source traffic as any address in the range. The one
# policy that widens it belongs to a tunnel that IS a node's way out, and this transport
# is refused on a hop (`hop_capable`), so in practice it never reaches this line.
AllowedIPs = {{ peer.allowed_ips }}
{% endfor %}
