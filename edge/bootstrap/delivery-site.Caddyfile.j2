{#
  What a delivery host serves out of its placed directory, and what it records.

  WHAT: one site, serving one pre-rendered file per request out of the directory the
        control plane placed, and 404 for everything else.
  WHY:  M27.3. A second listener on a second host is a second place a request path can
        be written down, and it is on a host whose logs nobody reads daily. Every
        logger this file can reach is discarded here, and the node's compose service
        keeps the container runtime from retaining what the process prints anyway —
        see edge/bootstrap/delivery_site.py, which renders both.
  HOW:  rendered by edge/bootstrap/delivery_site.py:render_delivery_site. The site
        ADDRESS is passed in and nothing about it is decided here: which hosts serve
        delivery and under which name is not this zone's to know, and a literal here
        would be an address the fleet cannot rotate away from.

  There is no application behind this. The request path carries the artifact's NAME,
  the name is the file's stem, and the only thing between the two is one rewrite — so
  there is nothing here that parses a credential, and nothing that could learn who
  fetched what even if it were asked to.
#}
# Generated by hashi. Do not edit on the node — it is overwritten on every apply,
# and the control database is the source of truth (core invariants §3).
{
	# THE DEFAULT LOGGER, and it is not the same one as the site's below. It catches
	# every request that matches no site block — a scan by address, another name
	# resolving here — and every http.log.error, including the ones a broken mount
	# would produce on exactly the request this host exists to answer. Both carry the
	# full URI, and the URI carries the name of one person's artifact.
	log {
		output discard
	}

	# No admin API on a node. It is a configuration socket on the most seizable host
	# in the fleet, it is of no use to anything here — this container is reconfigured
	# by being recreated, never reloaded in place — and Caddy binds it by default.
	admin off
}

{{ site_address }} {
	# The site's own logger, silenced for the reason the default one above is. This is
	# the one that would otherwise write a line per request, with the path in it.
	log {
		output discard
	}

	root * {{ directory }}

	# THE RESPONSE HEADERS BELOW GO ONLY WHERE THERE IS A DOCUMENT TO CARRY THEM, which
	# is what each block's `file` matcher is for. They are the control plane's own — the
	# same document served from two hosts must not come back with two different cache
	# rules — and on an empty 404 they would be something else entirely: a fixed set of
	# headers on an empty body is a signature, answered by every delivery host, on the
	# most scannable machine in the fleet. That is the argument CLAUDE.md makes about a
	# shared decoy destination, one layer up. The control plane answers an unknown token
	# with a bare 404 and its public site answers everything else with one, so a refusal
	# here is the same bare answer as both — and an unknown NAME is then indistinguishable
	# from a path that was never a subscription.

{% for shape in shapes %}
	# The {{ shape.format }} shape, asked for the way the control plane's own route
	# asks for it: one query value per SUBSCRIPTION FORMAT, so a format added later is
	# one more block here and a protocol added later is none.
	@{{ shape.matcher }} {
		path_regexp {{ shape.matcher }} {{ shape.pattern }}
		query format={{ shape.format }}
	}
	handle @{{ shape.matcher }} {
{% if shape.headers %}
		# The response headers, and the `file` matcher is what keeps them off a 404 — see
		# the comment above the first shape.
		@{{ shape.present }} file /{re.{{ shape.matcher }}.1}{{ shape.extension }}
		header @{{ shape.present }} {
{% for name, value in shape.headers %}
			{{ name }} `{{ value }}`
{% endfor %}
		}
{% endif %}
		rewrite * /{re.{{ shape.matcher }}.1}{{ shape.extension }}
		file_server
	}

{% endfor %}
	# No `format` at all — the shape a link a user already holds asks for, and the one
	# the control plane answers when the query is absent. It is its own block rather
	# than a fallthrough, and the `not` is what makes a shape this host does not have
	# a 404 instead of silently the default one: a host answering an unknown `format`
	# with a document is a second opinion about a vocabulary that is not this zone's.
	@{{ default_shape.matcher }} {
		path_regexp {{ default_shape.matcher }} {{ default_shape.pattern }}
		not query format=*
	}
	handle @{{ default_shape.matcher }} {
{% if default_shape.headers %}
		# The response headers, and the `file` matcher is what keeps them off a 404 — see
		# the comment above the first shape.
		@{{ default_shape.present }} file /{re.{{ default_shape.matcher }}.1}{{ default_shape.extension }}
		header @{{ default_shape.present }} {
{% for name, value in default_shape.headers %}
			{{ name }} `{{ value }}`
{% endfor %}
		}
{% endif %}
		rewrite * /{re.{{ default_shape.matcher }}.1}{{ default_shape.extension }}
		file_server
	}

	# Everything else, including a shape this host does not have and the directory
	# itself. An empty 404 with no headers of ours on it — the same answer `file_server`
	# above gives a name nothing is stored under, and the same one the control plane's
	# own public site gives anything that is not a subscription. Identical answers are
	# the point twice over: a scanner learns neither what else runs here nor whether a
	# name it guessed exists.
	handle {
		respond 404
	}
}
