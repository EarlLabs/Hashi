{#
  One user's plain WireGuard configuration.

  WHAT: the file a user imports — their own keypair, this node as the single peer.
  WHY:  a file rather than a link, because this protocol family's configuration IS a
        file. It reaches them through the second subscription format (items 26 and 27).
  HOW:  rendered by render.py's ``render_client_config``.

  Two things differ from server.j2, and both are deliberate:

  * **AllowedIPs is the whole internet here.** On a node the field is an authorisation
    list and must name exactly one peer's address; on a user's device the point of the
    transport is that everything leaves through the node. Same field, opposite answer,
    because the consumer is different. Both families, including the one no node in this
    fleet can carry — ``edge/egress.py``'s ``CLIENT_ROUTES`` is where that is argued.
  * **No ListenPort.** A client dials; it does not wait to be found. Pinning a source
    port would also make a user's traffic easier to correlate across networks.
#}
# hashi — generated for one device. Re-import after any rotation; the link never moves.
#
# NOTE, and it is not boilerplate: plain WireGuard is identifiable on the wire. On a
# network that inspects traffic this tunnel will not come up, and that is a property of
# the protocol rather than a fault in this file. Use the obfuscated exit there.
[Interface]
PrivateKey = {{ peer.private_key }}
Address = {{ peer.tunnel_address }}
MTU = {{ params.mtu }}
{% if resolvers %}
# The resolver this device asks inside the tunnel. Operator-supplied — this transport's
# own setting, or failing that the one on the node's record: there is no default, because
# a hardcoded resolver would be a fixed address this fleet could never rotate away from.
# It has to be here, because AllowedIPs below routes every address into the tunnel and
# that includes whichever resolver this device was using before.
DNS = {{ resolvers | join(", ") }}
{% else %}
# NO RESOLVER WAS SET FOR THIS NODE, and this line is the warning rather than a
# reassurance. AllowedIPs below routes EVERY address into the tunnel, and the resolver
# this device already uses is one of those addresses. If it is a private one on the
# network this device is sitting in, it cannot be reached from the far end, and while
# this tunnel is up no name will resolve: addresses still work, names do not. Ask whoever
# gave you this file to set a resolver.
{% endif %}

[Peer]
# The node. One peer, never a list: a user's device talks to the exit it was given.
PublicKey = {{ params.public_key }}
PresharedKey = {{ peer.preshared_key }}
# Everything, in both families, and the second family is the deliberate half. This node's
# exit is IPv4 only, so IPv6 sent into this tunnel is dropped there and goes nowhere —
# which is the better of two bad answers. Leaving IPv6 out of this line would be faster
# and would send it out of this device's own connection instead, showing a real address
# to every site that has an IPv6 one. The cost of dropping it is a pause before a site
# that has both answers over IPv4.
AllowedIPs = {{ routes | join(", ") }}
Endpoint = {{ endpoint }}
# Keeps the UDP path open through NAT and stateful middleboxes. 25s is below the
# shortest common UDP idle timeout.
PersistentKeepalive = 25
