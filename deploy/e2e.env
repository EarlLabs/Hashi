# hashi — the e2e stack's own environment.
#
# WHAT: values for every variable the base compose file requires, for the disposable
#       e2e stack only.
# WHY:  `make e2e-up` used to interpolate the base file against the owner's real `.env`
#       alone, so a `.env` missing any required key made the whole acceptance suite
#       unbootable — and the failure looked like a compose error rather than "your
#       environment is incomplete". Worse, it meant the e2e stack's identity depended on
#       the owner's real one, which is exactly what the e2e overlay exists to prevent.
# HOW:  passed as a SECOND `--env-file` after `.env` (see COMPOSE_E2E in the Makefile),
#       so these win for the e2e project and nothing else is affected. The dev and
#       production stacks never load this file.
#
# Everything here is fake and disposable, and it is committed on purpose: it guards a
# stack with no real nodes and no real users in it. Nothing in this file may ever be
# copied into `.env`.

# 48 characters, to satisfy the minimum length the application enforces at boot.
HASHI_SECRET_KEY=e2e-not-a-real-secret-key-0000000000000000000

# Overridden again by deploy/docker-compose.e2e.yml, which is what keeps a test run
# away from the owner's real delivery hostname.
HASHI_PUBLIC_HOST=localhost

HASHI_OPERATOR_USERNAME=owner
# scrypt hash of "e2e-operator-password". Every `$` is DOUBLED, and it has to be.
#
# `docker compose --env-file` interpolates the values it reads, so a lone `$` starts a
# variable reference. This file used to carry the hash undoubled, with a comment claiming
# env files are not interpolated — they are. Two of this hash's segments begin with a
# letter (`$QO…`, `$RK2…`), so compose read them as undefined variables and replaced them
# with nothing: the value arriving at the container was not this hash, operator login
# failed, and compose printed a fragment of the value as "The QO variable is not set".
# Fixed in item 32; the reasoning is recorded as backlog item 35.
#
# So: if you regenerate this value, double every `$`. scripts/panel-bootstrap.sh refuses
# an env file with an unescaped one for exactly this reason.
HASHI_OPERATOR_PASSWORD_HASH=scrypt$$32768$$8$$1$$QO/d/qvoYxARMag5H46vug==$$RK2Hhwuh2AIM0lympYvnnDhv6MrAHIyoV7KuOV4Y6pU=

# Fixed rather than generated: the e2e database volume is destroyed with the stack
# (`make e2e-down` runs `down -v`), but a password baked into a warm volume that changed
# between runs would break every connection after a restart.
POSTGRES_USER=hashi
POSTGRES_PASSWORD=e2e-not-a-real-password
POSTGRES_DB=hashi

# Never used — the e2e overlay makes Caddy issue from its own internal CA, so nothing
# here reaches a CA on the internet.
CADDY_ACME_EMAIL=e2e@localhost

# The private site — M7's panel-and-API half. An IP ADDRESS, and that is the whole
# point of this value: a WireGuard tunnel hands the owner an address, not a name, and
# every TLS client — curl, and every browser — omits SNI when the host is an IP literal.
# This stack ran for a whole milestone with `console.localhost` here, every scenario
# green, and the console was unreachable on the first real host for exactly that reason.
# A name in a test stack asks a question the field never asks.
#
# The address is deliberately one nothing in this stack can route to: it is used as a
# certificate subject and as a Host header, never dialled. Its own value also has to be
# distinctive, so `port 80 does not answer for the console's address` stays a question
# that can be asked. Caddy's internal CA issues for an IP exactly as it does for a name.
HASHI_PRIVATE_HOST=10.99.0.1
HASHI_PRIVATE_PORT=54443
