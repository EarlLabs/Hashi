# What `make restore-from-bucket` needs to rebuild the control plane on a new machine.
# Copy to secrets/restore.env and fill in. Keep it with you, not on the server:
# if the server is seized, this file must not be on it.
#
# Use it like this, on the new machine, from the repository checkout:
#   set -a; . /path/to/restore.env; set +a; make restore-from-bucket
# See docs/deploy/runbook.md, "Coming back from the bucket".

# The bucket the server uploads to (the same values as HASHI_BACKUP_S3_* in server.env).
HASHI_RESTORE_S3_ENDPOINT=https://storage.example.net
HASHI_RESTORE_S3_REGION=example-region-1
HASHI_RESTORE_S3_BUCKET=example-bucket-name
# Leave empty for the bucket root.
HASHI_RESTORE_S3_PREFIX=

# A key of a SECOND service account that may only READ the bucket (list + get).
# Not the server's write-only key. The restore never falls back to that one.
HASHI_RESTORE_S3_ACCESS_KEY_ID=
HASHI_RESTORE_S3_SECRET_ACCESS_KEY=

# Path to the secret half of the backup key (made by `age-keygen`, see secrets/README.md).
HASHI_RESTORE_AGE_IDENTITY=/path/to/secrets/hashi-backup-identity.txt
