{#
  The data plane on one node.

  WHAT: one container per enabled transport, each running the pinned upstream image
        its own config FORMAT declared — the two VLESS transports share one, an
        AmneziaWG hop needs a different daemon entirely.
  WHY:  a container per transport rather than one Xray with many inbounds: a config
        error in a newly enabled protocol then cannot take down the protocol every
        existing user is already using. Enabling a transport is supposed to be
        safe (criterion 3), and blast radius is how that is made true.
  HOW:  rendered by edge/bootstrap/node_stack.py:render_compose. The image tag is
        passed in — never a literal here, because core invariants §5 pins the data
        plane to an exact patch version and the pin belongs in configuration.

  network_mode: host, deliberately. These containers must listen on the node's real
  interface on the operator-chosen port, and a bridge network would put the client's
  source address behind a NAT — which changes nothing for us functionally, but adds
  a hop that fragments UDP and is the "TLS works, large downloads hang" trap the
  edge rulebook warns about.

  No logging driver options and no access logs: the Xray configs themselves set
  `access: none`, and there is nothing here to write a connection record to.
#}
# Generated by hashi. Do not edit on the node — it is overwritten on every apply,
# and the control database is the source of truth (core invariants §3).
name: hashi-node

services:
{% for transport in transports %}
  {{ transport.name }}:
    image: {{ transport.image }}
    restart: unless-stopped
    network_mode: host
{% if transport.command %}
    # Rendered through `tojson` rather than quoted by hand, which is what this line used
    # to do. A data plane's command may legitimately be a shell command line (the
    # WireGuard family's is), and that carries quotes and other YAML metacharacters that
    # hand-quoting emits unescaped and unparseably. JSON is a subset of YAML, so a JSON
    # array is a valid — and correctly escaped — compose command.
    #
    # Omitted entirely when the data plane declares no command, which means "the image's
    # own Cmd is already right". An empty `command: []` would not mean that: it would
    # override the image's Cmd with nothing and the container would refuse to start.
    command: {{ transport.command | tojson }}
{% endif %}
{% if transport.capabilities %}
    # Only what the transport's own format declared it needs. A tunnel device cannot
    # be created without NET_ADMIN; nothing else gets it, so a compromised proxy
    # container cannot reconfigure the node's network.
    cap_add:
{% for capability in transport.capabilities %}
      - {{ capability }}
{% endfor %}
{% endif %}
{% if transport.devices %}
    devices:
{% for device in transport.devices %}
      - {{ device }}
{% endfor %}
{% endif %}
    labels:
      # The digest of the config THIS service loads, and the reason an apply reaches
      # the running daemon at all. `up -d` compares the service DEFINITION against the
      # running container, and a bind-mounted file's contents are not part of that — so
      # without this line a new config never restarted anything, and a revoked user
      # stayed connected. The value also reads back through `docker inspect`, which
      # reports the labels a container was CREATED with. Full reasoning at
      # edge/bootstrap/node_stack.py:CONFIG_DIGEST_LABEL. It is a SHA-256 of the
      # rendered config, so it discloses nothing to anyone reading it here.
      {{ digest_label }}: "{{ transport.config_digest }}"
    volumes:
      # Read-only: the daemon has no reason to write to its own configuration, and
      # a compromised data plane must not be able to rewrite what it will load next.
      - {{ config_dir }}:{{ config_dir }}:ro
    logging:
      driver: json-file
      options:
        # Bounded so a chatty warning loop cannot fill a small VPS's disk and take
        # the node down. Small, because there is nothing here worth keeping: these
        # are daemon warnings, and connection records do not exist by construction.
        max-size: "10m"
        max-file: "2"
{% endfor %}
{% if delivery %}

  # The delivery listener — M27.3. Serves the directory the control plane placed, and
  # is the one container here that answers a request from a person rather than from a
  # client of a transport. What it may write down is the whole of that step: see
  # edge/bootstrap/delivery_site.py.
  {{ delivery.name }}:
    image: {{ delivery.image }}
    restart: unless-stopped
    # Same reason as the data planes above: it has to answer on the node's real
    # interface, on whatever port its site address names, and a bridge would mean
    # naming that port a second time in a published mapping.
    network_mode: host
    command: {{ delivery.command | tojson }}
    labels:
      # The digest of the SITE CONFIGURATION this container was created with, for the
      # reason each transport above carries one: `up -d` compares the service
      # definition and a bind-mounted file's contents are not part of it, so without
      # this a host handed a changed site would go on serving the previous one.
      {{ digest_label }}: "{{ delivery.config_digest }}"
    volumes:
      # Read-only, both of them, and neither is the config directory. The listener has
      # no reason to write anywhere, and the directory it serves is REPLACED wholesale
      # by the next apply — a process that could write into it would be writing into
      # something with an owner.
      - {{ delivery.site_path }}:{{ delivery.site_path }}:ro
      - {{ delivery.directory }}:{{ delivery.directory }}:ro
    logging:
      # NOTHING IS RETAINED, and this is not the bounded json-file the data planes
      # above get. A request to this container carries the name of one person's
      # artifact, which is how that artifact is fetched; Caddy discards its own
      # loggers, and this is what makes that true of anything it prints anyway — a
      # panic, a configuration it will not load, a directive that logs by default in
      # some later version. Measured on engine 29.4.0: with json-file, the three lines
      # Caddy writes before it applies its own logging configuration are kept in the
      # node's journal, and with this they are not.
      #
      # The cost is real and is the smaller one: this container's startup diagnostics
      # are gone, and an operator debugging a listener that will not start runs the
      # image by hand on the node instead.
      driver: none
{% endif %}
